# Copy to deploy.local.env and fill in real values. deploy.local.env is gitignored.

# Remote MotionEye
MOTIONEYE_URL=http://motioneye.example.local:8765
MOTIONEYE_USER=admin
MOTIONEYE_PASSWORD=changeme

# Shared SSO secret (must match the kukle-power SECRET_KEY)
SECRET_KEY=replace-with-shared-secret

# Auth behaviour
AUTH_ENABLED=true
KUKLE_POWER_LOGIN_URL=http://kukle-power.example.local/

# Host volumes
CONFIG_DIR=/host/path/to/DockerConfig/motioneye-proxy-gallery
MEDIA_ROOT=/host/path/to/motioneye

# Indexer tuning
INDEX_INTERVAL_SECONDS=900
REQUEST_TIMEOUT_MS=30000
MAX_RETRIES=5

# Extended AI detection pass (optional, disabled by default)
# Requires LM Studio with "Serve on Local Network" enabled and port 1234 open in Windows Firewall.
AI_TAGGING_ENABLED=false
AI_LMSTUDIO_URL=http://192.168.0.11:1234
AI_MODEL=qwen/qwen3-vl-8b
AI_PROBE_INTERVAL_SECONDS=300
AI_IMAGE_WIDTH=1024
AI_PROMPT_VERSION=semantics-v1
AI_WEATHER_PROMPT_VERSION=weather-v1
AI_WEATHER_MIN_GAP_SECONDS=600
AI_BATCH=200
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_FAILURES=5
# Loop B's own night/IR gate, separate from ACTIVITY_COLOR_THRESHOLD (loop A). Retuning
# loop A's motion sensitivity must never silently change which frames loop B calls
# "night" and therefore excludes from the weather question.
AI_NIGHT_COLOR_THRESHOLD=8
# When true (default), the gallery triggers LM Studio's just-in-time load itself
# whenever the model is reachable and downloaded but not resident, instead of waiting
# for the owner to load it by hand. AI_MODEL_TTL_SECONDS is attached to that
# load-triggering request so LM Studio evicts the model (freeing the GPU) once it has
# been idle past that many seconds.
AI_AUTOLOAD_MODEL=true
AI_MODEL_TTL_SECONDS=1800

# Portainer deploy (used by deploy.sh only)
PORTAINER_URL=http://portainer.example.local:9000/api
PORTAINER_API_KEY=replace-with-portainer-api-key
STACK_NAME=motioneye-proxy-gallery
